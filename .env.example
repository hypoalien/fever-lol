# Copy to .env.local and fill in. Everything except DATABASE_URL is optional
# for local development — the app degrades gracefully when a key is absent.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
#   docker compose up -d postgres && bun run db:migrate && bun run db:seed
DATABASE_URL=postgres://fever:fever@localhost:5433/fever_lol

# MongoDB is still read by the routes that have not been ported yet, and by the
# one-off user import. It is removed once the port completes.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must be exactly 32 characters — used as the AES-256 key for gateway secrets.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email (magic links, via Resend)
# ---------------------------------------------------------------------------
AUTH_RESEND_KEY=
EMAIL_SERVER_USER=resend
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Payments (Razorpay)
# ---------------------------------------------------------------------------
# Organizers connect their own Razorpay account under Settings > Payments, and
# buyers pay that account directly — the platform never holds ticket revenue.
# These platform-level keys are therefore only a fallback, and only when the
# flag below is on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Let events whose organizer has not connected an account fall back to the
# platform keys above. Correct for a single-tenant install (you running this
# for your own events) and for local development. Leave unset in any
# multi-tenant deployment: you would be collecting money you cannot pay out.
ALLOW_PLATFORM_GATEWAY_FALLBACK=

# The browser now takes the key id from the create-order response, so it always
# matches whichever account the order was opened on.

# Rate applied server-side when an event is priced in USD but charged in INR.
# A stopgap until there is a real FX source or a per-currency gateway.
USD_INR_RATE=88

# ---------------------------------------------------------------------------
# File storage (event flyers)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Canonical origin, used for canonical tags, the sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: emits the Google Search Console verification meta tag when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Analytics (PostHog) — optional
# ---------------------------------------------------------------------------
# Everything degrades to a no-op when the key is absent, so contributors do
# not need an account. The phc_ key is a public project key by design.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
