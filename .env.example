# Copy to .env.local and fill in. Everything except DATABASE_URL is optional
# for local development — the app degrades gracefully when a key is absent.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
#   docker compose up -d postgres && bun run db:migrate && bun run db:seed
DATABASE_URL=postgres://fever:fever@localhost:5433/fever_lol

# MongoDB is still read by the routes that have not been ported yet, and by the
# one-off user import. It is removed once the port completes.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must be exactly 32 characters — used as the AES-256 key for gateway secrets.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email (magic links, via Resend)
# ---------------------------------------------------------------------------
AUTH_RESEND_KEY=
EMAIL_SERVER_USER=resend
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Payments (Razorpay)
# ---------------------------------------------------------------------------
# Checkout returns 503 rather than failing obscurely when these are unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Rate applied server-side when an event is priced in USD but charged in INR.
# A stopgap until there is a real FX source or a per-currency gateway.
USD_INR_RATE=88

# ---------------------------------------------------------------------------
# File storage (event flyers)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# ---------------------------------------------------------------------------
# Analytics (PostHog) — optional
# ---------------------------------------------------------------------------
# Everything degrades to a no-op when the key is absent, so contributors do
# not need an account. The phc_ key is a public project key by design.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
