{
  "name": "fever-lol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "test:integration": "./scripts/prepare-test-db.sh && vitest run --config vitest.integration.config.mts",
    "users:import:dry": "tsx scripts/import-mongo-users.ts --dry-run",
    "users:import": "tsx scripts/import-mongo-users.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun run typecheck && bun run lint && bun run test && bun run test:integration && bun run test:e2e",
    "cf:build": "node scripts/build-worker.mjs",
    "cf:preview": "node scripts/build-worker.mjs && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/build-worker.mjs && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
