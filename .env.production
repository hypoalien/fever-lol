# Build-time values for the Worker build. Committed on purpose: everything here
# is NEXT_PUBLIC_*, which Next compiles into the client bundle and is therefore
# public whatever we do. Secrets never belong in this file — scripts/build-worker.mjs
# fails the build if anything secret-looking reaches the generated env module.
NEXT_PUBLIC_SITE_URL=https://fever-lol.fever-lol.workers.dev
NEXT_PUBLIC_POSTHOG_KEY=phc_AErxGV8X2i7ov249VxP3sdmFvqXPBakfqyKyyk3LG3mT
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
